<?xml version="1.0" encoding="utf-8"?>
<!--
    Release / profile network policy.

    Everything is HTTPS. The only cleartext exceptions are loopback names,
    which cannot be reached from another machine, so they are safe to leave in:
    they exist purely so a local `wrangler dev` still works if someone builds
    this variant for testing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
