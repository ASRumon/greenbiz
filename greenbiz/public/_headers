# Headers for the static dashboard (Workers assets honour this file).
#
# The token lives in localStorage, so the page is worth hardening: no framing,
# no plugins, and forms may only post to this origin. Inline script and style are
# required because the dashboard is a single self-contained document.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
